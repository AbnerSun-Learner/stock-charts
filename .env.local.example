# Supabase 公开配置（勿写入真实值到仓库）
# 项目 URL 不要带 /rest/v1 后缀
NEXT_PUBLIC_SUPABASE_URL=
# 匿名 / publishable key（二选一即可；优先 ANON_KEY）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 可选：站内绝对 URL（OAuth 回调与 OG）
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# —— GitHub OAuth（在 Supabase Dashboard 配置，勿把 Client Secret 写入本仓）——
# 1. GitHub → Settings → Developer settings → OAuth Apps → New
#    Homepage URL: http://localhost:3000（或生产域名）
#    Authorization callback URL: https://<PROJECT_REF>.supabase.co/auth/v1/callback
# 2. Supabase → Authentication → Providers → GitHub：填入 Client ID / Secret 并 Enable
# 3. Supabase → Authentication → URL Configuration → Redirect URLs 加入：
#    http://localhost:3000/auth/callback
#    http://localhost:3000/auth/callback**
#    （生产域名同理）
